# GEMINI_API_KEY: Required for Gemini AI API calls (embeddings, analysis, RAG chat, gap finder, etc.)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MONGODB_URI: MongoDB Atlas or local MongoDB connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ai_in_research_paper?retryWrites=true&w=majority
# Leave empty to use local JSON persistence (data/store.json) during development.
MONGODB_URI=""

# JWT_SECRET: Secret key used to sign authentication JWT tokens
JWT_SECRET="replace_with_a_long_random_secret_in_production"

# CORS_ORIGIN: Allowed frontend origin (optional, defaults to same-origin / *)
CORS_ORIGIN="http://localhost:3000"

# PORT: Server port (AI Studio uses 3000)
PORT=3000

# APP_URL: Hosted URL
APP_URL="MY_APP_URL"
